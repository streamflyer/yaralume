{
  "expo": {
    "name": "Yaralume",
    "slug": "yaralume",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yaralume",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F3F6F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.yaralume.app"
    },
    "android": {
      "package": "ch.yaralume.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
